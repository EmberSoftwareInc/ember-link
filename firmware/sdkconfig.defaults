# EmberConnect — LilyGo T-Dongle-S3 (ESP32-S3, 16 MB flash, no PSRAM)
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_TINYUSB_MSC_ENABLED=y

# CDC-ACM serial alongside the mass-storage interface: the channel Ember
# Bridge uses for desktop (USB) provisioning. Buffers sized for streaming
# firmware images down without starving the FIFO.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024

# Long filenames on the FAT volume (design names come from users)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# USB-OTG owns the USB PHY; no secondary console
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# HTTP uploads stream through the httpd task; give it headroom
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Signed OTA (app signatures without secure boot): every build is signed
# with keys/ota_signing_key.pem (RSA-3072, secure-boot-v2 scheme) and
# esp_ota_end() rejects pushed images whose signature doesn't verify against
# the public key embedded in the running app. No eFuses are burned — USB
# reflash always works. The key is gitignored; keep an offline backup, or
# fielded dongles can never be updated over WiFi again.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/ota_signing_key.pem"

# A freshly-flashed image boots as "pending verify"; if it never confirms
# itself healthy (ota_confirm) the bootloader falls back to the old slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Cloud HTTPS verifies server certificates; plaintext is never supported.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Accept valid cross-signed chains using a root already in the trusted bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
